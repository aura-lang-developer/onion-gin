// ==============================================================================
// Unit Test Suite: Domain Layer
// tests/domain_test.aura - Tests Domain Aggregates, Invariants & Business Logic
// ==============================================================================

import { Product, NewProduct } from "../internal/domain/model/product";
import { Order, OrderItem, NewOrder, NewOrderItem, OrderStatusPending, OrderStatusConfirmed, OrderStatusShipped, OrderStatusDelivered, OrderStatusCancelled } from "../internal/domain/model/order";
import { PricingService, NewPricingService } from "../internal/domain/service/pricing_service";
import { ErrInsufficientStock, ErrInvalidOrderStatus, IsDomainError } from "../internal/domain/errors";
import { NewDomainEvent, EventOrderCreated, EventOrderConfirmed } from "../internal/domain/events";

export fn main(): Unit => {
  let mut passed = 0;
  let mut failed = 0;

  println("================================================================================");
  println("  🧅 ONION ARCHITECTURE - DOMAIN LAYER TESTS");
  println("================================================================================");

  // ----------------------------------------------------------------------------
  // Product Aggregate Tests
  // ----------------------------------------------------------------------------
  println("\n--- [Product Invariants & Stock Management] ---");

  let prodRes = NewProduct("p1", "SKU-001", "Mechanical Keyboard", 120.00, 10);
  match prodRes {
    Ok(initProd) => {
      let mut prod = initProd;

      // Test 1: Stock reservation success
      if prod.CanReserve(5) {
        let res = prod.ReserveStock(5);
        match res {
          Ok(_) => {
            if prod.stock == 5 {
              println("  ✓ PASS: Reserved 5 units, remaining stock is 5");
              passed += 1;
            } else {
              println(`  ✕ FAIL: Expected stock 5, got ${prod.stock}`);
              failed += 1;
            }
          },
          Err(e) => {
            println(`  ✕ FAIL: ReserveStock failed: ${e}`);
            failed += 1;
          }
        };
      } else {
        println("  ✕ FAIL: CanReserve(5) returned false");
        failed += 1;
      };

      // Test 2: Stock reservation failure when insufficient
      if !prod.CanReserve(10) {
        let resOver = prod.ReserveStock(10);
        match resOver {
          Ok(_) => {
            println("  ✕ FAIL: ReserveStock should have rejected over-reservation");
            failed += 1;
          },
          Err(e) => {
            if e.startsWith(ErrInsufficientStock()) {
              println("  ✓ PASS: ReserveStock correctly rejected with ErrInsufficientStock");
              passed += 1;
            } else {
              println(`  ✕ FAIL: Unexpected error message: ${e}`);
              failed += 1;
            }
          }
        };
      } else {
        println("  ✕ FAIL: CanReserve(10) should have returned false");
        failed += 1;
      };

      // Test 3: Release stock
      prod.ReleaseStock(3);
      if prod.stock == 8 {
        println("  ✓ PASS: ReleaseStock restored 3 units (new stock: 8)");
        passed += 1;
      } else {
        println(`  ✕ FAIL: Expected stock 8, got ${prod.stock}`);
        failed += 1;
      };

      // Test 4: Restock
      let restockRes = prod.Restock(12);
      match restockRes {
        Ok(_) => {
          if prod.stock == 20 {
            println("  ✓ PASS: Restock added 12 units (new stock: 20)");
            passed += 1;
          } else {
            println(`  ✕ FAIL: Expected stock 20, got ${prod.stock}`);
            failed += 1;
          }
        },
        Err(e) => {
          println(`  ✕ FAIL: Restock failed: ${e}`);
          failed += 1;
        }
      };
    },
    Err(e) => {
      println(`  ✕ FAIL: NewProduct creation failed: ${e}`);
      failed += 1;
    }
  };

  // ----------------------------------------------------------------------------
  // Order Aggregate & Invariant Tests
  // ----------------------------------------------------------------------------
  println("\n--- [Order Lifecycle & State Transitions] ---");

  let item1 = NewOrderItem("p1", "Mechanical Keyboard", 120.00, 2);
  if item1.subtotal == 240.00 {
    println("  ✓ PASS: OrderItem subtotal calculated accurately: 240.00");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Subtotal mismatch: ${item1.subtotal}`);
    failed += 1;
  };

  let ordRes = NewOrder("ord_100", "cust_alice", [item1], 0.10, 0.00);
  match ordRes {
    Ok(initOrd) => {
      let mut ord = initOrd;

      if ord.status == OrderStatusPending() {
        println("  ✓ PASS: Newly created order is in Pending state");
        passed += 1;
      } else {
        println(`  ✕ FAIL: Initial state was: ${ord.status}`);
        failed += 1;
      };

      // Test state transition: Pending -> Confirmed
      let confRes = ord.Confirm();
      match confRes {
        Ok(_) => {
          if ord.status == OrderStatusConfirmed() {
            println("  ✓ PASS: Order transitioned to Confirmed");
            passed += 1;
          } else {
            println(`  ✕ FAIL: Expected status confirmed, got ${ord.status}`);
            failed += 1;
          }
        },
        Err(e) => {
          println(`  ✕ FAIL: Confirm failed: ${e}`);
          failed += 1;
        }
      };

      // Test state transition: Confirmed -> Shipped
      let shipRes = ord.Ship();
      match shipRes {
        Ok(_) => {
          if ord.status == OrderStatusShipped() {
            println("  ✓ PASS: Order transitioned to Shipped");
            passed += 1;
          } else {
            println(`  ✕ FAIL: Expected status shipped, got ${ord.status}`);
            failed += 1;
          }
        },
        Err(e) => {
          println(`  ✕ FAIL: Ship failed: ${e}`);
          failed += 1;
        }
      };

      // Test state transition: Shipped -> Delivered
      let delivRes = ord.Deliver();
      match delivRes {
        Ok(_) => {
          if ord.status == OrderStatusDelivered() {
            println("  ✓ PASS: Order transitioned to Delivered");
            passed += 1;
          } else {
            println(`  ✕ FAIL: Expected status delivered, got ${ord.status}`);
            failed += 1;
          }
        },
        Err(e) => {
          println(`  ✕ FAIL: Deliver failed: ${e}`);
          failed += 1;
        }
      };

      // Test invalid transition: Cannot cancel a delivered order
      let cancelAfterDelivery = ord.Cancel("Wrong item");
      match cancelAfterDelivery {
        Ok(_) => {
          println("  ✕ FAIL: Delivered order should not be cancellable");
          failed += 1;
        },
        Err(e) => {
          if e.startsWith(ErrInvalidOrderStatus()) {
            println("  ✓ PASS: Cancelling delivered order rejected with ErrInvalidOrderStatus");
            passed += 1;
          } else {
            println(`  ✕ FAIL: Expected ErrInvalidOrderStatus, got: ${e}`);
            failed += 1;
          }
        }
      };
    },
    Err(e) => {
      println(`  ✕ FAIL: NewOrder creation failed: ${e}`);
      failed += 1;
    }
  };

  // ----------------------------------------------------------------------------
  // Pricing Domain Service Tests
  // ----------------------------------------------------------------------------
  println("\n--- [Pricing Domain Service & Taxes] ---");

  let pricing = NewPricingService(0.10, 0.15); // 10% tax, 15% VIP discount

  // Standard customer calculation
  let stdCalc = pricing.CalculateTotals([item1], false);
  if stdCalc.subtotal == 240.00 && stdCalc.discount == 0.00 && stdCalc.tax == 24.00 && stdCalc.total == 264.00 {
    println("  ✓ PASS: Standard customer totals: subtotal=240, discount=0, tax=24, total=264");
    passed += 1;
  } else {
    println(`  ✕ FAIL: Standard calc mismatch: subtotal=${stdCalc.subtotal}, discount=${stdCalc.discount}, tax=${stdCalc.tax}, total=${stdCalc.total}`);
    failed += 1;
  };

  // VIP customer calculation: 240 * 0.15 = 36 discount; discounted = 204; tax = 20.4; total = 224.4
  let vipCalc = pricing.CalculateTotals([item1], true);
  let isVipTaxClose = vipCalc.tax >= 20.39 && vipCalc.tax <= 20.41;
  let isVipTotalClose = vipCalc.total >= 224.39 && vipCalc.total <= 224.41;
  if vipCalc.discount == 36.00 && isVipTaxClose && isVipTotalClose {
    println("  ✓ PASS: VIP customer totals: discount=36, tax≈20.40, total≈224.40");
    passed += 1;
  } else {
    println(`  ✕ FAIL: VIP calc mismatch: discount=${vipCalc.discount}, tax=${vipCalc.tax}, total=${vipCalc.total}`);
    failed += 1;
  };

  // ----------------------------------------------------------------------------
  // Domain Events & Error Classification
  // ----------------------------------------------------------------------------
  println("\n--- [Domain Events & Error Classification] ---");

  let evt = NewDomainEvent(EventOrderCreated(), "ord_100", "{\"items\": 1}");
  if evt.eventType == EventOrderCreated() && evt.aggregateId == "ord_100" {
    println("  ✓ PASS: Domain event created with correct type and aggregate ID");
    passed += 1;
  } else {
    println("  ✕ FAIL: Domain event properties mismatch");
    failed += 1;
  };

  if IsDomainError(ErrInsufficientStock()) && !IsDomainError("RANDOM_UNKNOWN_ERROR") {
    println("  ✓ PASS: IsDomainError predicate classified error codes correctly");
    passed += 1;
  } else {
    println("  ✕ FAIL: Domain error predicate failed");
    failed += 1;
  };

  // Summary
  println("\n================================================================================");
  println(`  Domain Test Suite Completed: ${passed} Passed, ${failed} Failed`);
  println("================================================================================");

  if failed > 0 {
    panic("Some domain tests failed");
  }
}
